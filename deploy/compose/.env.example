# Copy to deploy/compose/.env and fill in. Never commit the filled-in file.
# Every variable is explained in docs/deploy.md.

# Public domain (a DNS A/AAAA record pointing at this host). Caddy gets the
# HTTPS certificate for it automatically.
DOMAIN=learn.example.com

# Images: where `docker compose build` tags them / where CI pushes them.
REGISTRY=ghcr.io/your-org/logixai
TAG=latest

# MongoDB: the cluster URI WITHOUT a database name, and its options.
# Each service appends its own database (logixai-identity, logixai-arena, ...).
#   Atlas:           mongodb+srv://USER:PASSWORD@cluster0.abcde.mongodb.net
#   bundled (profile bundled-mongo): mongodb://mongo:27017
MONGODB_URI_BASE=
MONGODB_URI_OPTIONS=?retryWrites=true&w=majority

# Redis (queues and socket fan-out). The bundled redis service uses this password.
# For a managed Redis set REDIS_HOST/REDIS_PORT/REDIS_TLS=true and scale redis to 0.
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TLS=false

# Signing key for access tokens (Ed25519, PKCS8 PEM; generate with
# `openssl genpkey -algorithm ed25519`). Keep it stable: changing it signs everyone out.
JWT_PRIVATE_KEY=
JWT_KEY_ID=logixai-1

# Shared secret between services (at least 16 characters; `openssl rand -hex 32`).
INTERNAL_API_TOKEN=

# Accounts created with these emails become platform admins (comma-separated).
BOOTSTRAP_ADMIN_EMAILS=

# Payments (leave empty for the mock checkout).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Judge: submissions judged at once per evaluator container, and the registry
# holding the judge images (python-ml, node-web) built from judge-images/.
JUDGE_CONCURRENCY=2
JUDGE_IMAGE_REGISTRY=ghcr.io/your-org/logixai

# Free-plan code runs per minute per user.
CODE_RUNS_PER_MINUTE=12

# MongoDB connections per service replica (see docs/deploy.md, "Connection budget").
MONGO_MAX_POOL_SIZE=20

# Judge queues served by this host's evaluator (empty = all), warm sandboxes per
# language, and the backlog above which Run says "busy" (Submit always queues).
JUDGE_QUEUES=
JUDGE_WARM_POOL=1
JUDGE_BUSY_BACKLOG=500

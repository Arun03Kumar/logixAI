# Copy to .env and adjust.
PORT=3006
NODE_ENV=development
DB_CONNECTION_STRING=mongodb://localhost:27017/logixai-identity
# Ed25519 private key (PKCS8 PEM, \n-escaped). Required in production;
# generate with: node -e "const {generateKeyPairSync}=require(\"crypto\");console.log(generateKeyPairSync(\"ed25519\").privateKey.export({type:\"pkcs8\",format:\"pem\"}).replace(/\n/g,\"\\n\"))"
JWT_PRIVATE_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3008
# Comma-separated emails that get the platform admin role on sign-up
BOOTSTRAP_ADMIN_EMAILS=
# Shared secret for /internal routes (must match billing-service). Required in production.
INTERNAL_API_TOKEN=

# Copy to .env and adjust.
PORT=3006
NODE_ENV=development
DB_CONNECTION_STRING=mongodb://localhost:27017/logixai-identity
# Ed25519 private key (PKCS8 PEM, \n-escaped). Required in production;
# generate with: node -e "const {generateKeyPairSync}=require(\"crypto\");console.log(generateKeyPairSync(\"ed25519\").privateKey.export({type:\"pkcs8\",format:\"pem\"}).replace(/\n/g,\"\\n\"))"
JWT_PRIVATE_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3008
# Comma-separated emails that get the platform admin role on sign-up
BOOTSTRAP_ADMIN_EMAILS=
# Shared secret for /internal routes (must match billing-service). Required in production.
INTERNAL_API_TOKEN=
# Public path of the auth routes, for the refresh cookie. Behind the deploy/ router: /api/identity/v1/auth
REFRESH_COOKIE_PATH=/api/v1/auth
# On SIGTERM, report not-ready for this long before closing (default 5000 in production, 0 otherwise)
SHUTDOWN_DRAIN_MS=
# Rate-limit counters: memory (one process) or redis (shared by all replicas; use in production)
RATE_LIMIT_STORE=memory
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# MongoDB connections per replica (default 20) and kept open while idle (default 0)
MONGO_MAX_POOL_SIZE=
MONGO_MIN_POOL_SIZE=
# Sign-up / sign-in attempts per minute per IP (default 10). Raise only on staging, for load tests.
AUTH_RATE_LIMIT_PER_MINUTE=

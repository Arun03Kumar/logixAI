    "@fastify/rate-limit": "^11.2.2",
    "@logixai/contracts": "*",
    "@logixai/service-kit": "*",
    "fastify": "^5.4.0",
    "jose": "^5.10.0",
    "mongoose": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}

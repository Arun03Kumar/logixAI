# Copy to .env.local and adjust. Values are public.
# NEXT_PUBLIC_* are inlined at build time (local development). A deployed web
# server reads PUBLIC_* at runtime instead (PUBLIC_ARENA_API_URL, ...), which win
# over these, so one image works for any domain. See docs/deploy.md.
NEXT_PUBLIC_PROBLEM_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SUBMISSION_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3005
NEXT_PUBLIC_IDENTITY_API_URL=http://localhost:3006/api/v1
NEXT_PUBLIC_EXAM_API_URL=http://localhost:3007/api/v1
NEXT_PUBLIC_ARENA_API_URL=http://localhost:3010/api/v1
NEXT_PUBLIC_BILLING_API_URL=http://localhost:3011/api/v1

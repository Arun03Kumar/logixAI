# Copy to .env and adjust.
PORT=3000
NODE_ENV=development
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Required in production (Redis AUTH). Set REDIS_TLS=true for managed Redis over TLS.
REDIS_PASSWORD=
REDIS_TLS=false
DB_CONNECTION_STRING=mongodb://localhost:27017/logixai-submissions
PROBLEM_ADMIN_SERVICE_URL=http://localhost:3001
SOCKET_SERVICE_URL=http://localhost:3005
IDENTITY_JWKS_URL=http://localhost:3006/.well-known/jwks.json
# Shared with problem-service and socket-service. Required in production.
INTERNAL_API_TOKEN=
# On SIGTERM, report not-ready for this long before closing (default 5000 in production, 0 otherwise)
SHUTDOWN_DRAIN_MS=
# MongoDB connections per replica (default 20) and kept open while idle (default 0)
MONGO_MAX_POOL_SIZE=
MONGO_MIN_POOL_SIZE=

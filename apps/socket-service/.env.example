# Copy to .env and adjust.
PORT=3005
NODE_ENV=development
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Required in production (Redis AUTH). Set REDIS_TLS=true for managed Redis over TLS.
REDIS_PASSWORD=
REDIS_TLS=false
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3008
IDENTITY_JWKS_URL=http://localhost:3006/.well-known/jwks.json
# Shared secret for /sendPayload (must match submission-service). Required in production.
INTERNAL_API_TOKEN=

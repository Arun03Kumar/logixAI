# Copy to .env and adjust.
PORT=3011
NODE_ENV=development
DB_CONNECTION_STRING=mongodb://localhost:27017/logixai-billing
IDENTITY_URL=http://localhost:3006
IDENTITY_JWKS_URL=http://localhost:3006/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3008
# Must match identity-service's INTERNAL_API_TOKEN. Required in production.
INTERNAL_API_TOKEN=
# Razorpay keys (Dashboard > Account & Settings > API keys). Test keys start rzp_test_.
# Leave empty in development to use the mock checkout (no money moves).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set on the webhook (Dashboard > Webhooks; events payment.captured and order.paid).
RAZORPAY_WEBHOOK_SECRET=
# On SIGTERM, report not-ready for this long before closing (default 5000 in production, 0 otherwise)
SHUTDOWN_DRAIN_MS=
# Rate-limit counters: memory (one process) or redis (shared by all replicas; use in production)
RATE_LIMIT_STORE=memory
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# MongoDB connections per replica (default 20) and kept open while idle (default 0)
MONGO_MAX_POOL_SIZE=
MONGO_MIN_POOL_SIZE=

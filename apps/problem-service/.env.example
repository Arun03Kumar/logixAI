# Copy to .env and adjust.
PORT=3001
NODE_ENV=development
DB_CONNECTION_STRING=mongodb://localhost:27017/logixai-problems
IDENTITY_JWKS_URL=http://localhost:3006/.well-known/jwks.json
# Shared secret for the hidden-tests endpoint (must match submission-service). Required in production.
INTERNAL_API_TOKEN=
# On SIGTERM, report not-ready for this long before closing (default 5000 in production, 0 otherwise)
SHUTDOWN_DRAIN_MS=
# MongoDB connections per replica (default 20) and kept open while idle (default 0)
MONGO_MAX_POOL_SIZE=
MONGO_MIN_POOL_SIZE=

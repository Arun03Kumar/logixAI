# Copy to .env and adjust.
PORT=3010
NODE_ENV=development
DB_CONNECTION_STRING=mongodb://localhost:27017/logixai-arena
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Required in production (Redis AUTH). Set REDIS_TLS=true for managed Redis over TLS.
REDIS_PASSWORD=
REDIS_TLS=false
IDENTITY_API_URL=http://localhost:3006/api/v1
IDENTITY_JWKS_URL=http://localhost:3006/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3008
# Code runs (run + submit) per learner per minute
CODE_RUNS_PER_MINUTE=12
# On SIGTERM, report not-ready for this long before closing (default 5000 in production, 0 otherwise)
SHUTDOWN_DRAIN_MS=
# MongoDB connections per replica (default 20) and kept open while idle (default 0)
MONGO_MAX_POOL_SIZE=
MONGO_MIN_POOL_SIZE=
# Server Runs get "busy, try again" (429) while more jobs than this wait for the judge
JUDGE_BUSY_BACKLOG=500

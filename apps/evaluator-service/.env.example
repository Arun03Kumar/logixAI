# Copy to .env and adjust.
PORT=3002
NODE_ENV=development
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Required in production (Redis AUTH). Set REDIS_TLS=true for managed Redis over TLS.
REDIS_PASSWORD=
REDIS_TLS=false
# Submissions judged at once by this process (one sandbox each)
JUDGE_CONCURRENCY=2
# Per-test time limit before the language multiplier (C++ x1, Java x2, Python x3)
BASE_TIME_LIMIT_MS=2000
COMPILE_TIMEOUT_MS=20000
SUBMISSION_BUDGET_MS=60000
# Production: registry holding the judge images, e.g. ghcr.io/acme/logixai (logixai/python-ml:4 -> <registry>/python-ml:4)
JUDGE_IMAGE_REGISTRY=
# On SIGTERM, report not-ready for this long before closing (default 5000 in production, 0 otherwise)
SHUTDOWN_DRAIN_MS=
# Queue groups served, optionally with concurrency: python-ml:3,node-web,dsa (empty = all at JUDGE_CONCURRENCY)
JUDGE_QUEUES=
# Started, unused sandboxes kept ready per language (0 = off)
JUDGE_WARM_POOL=1

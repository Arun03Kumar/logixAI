# Keeps the Docker build context small and secrets out of images.
# Images are built from the repository root: see deploy/docker/.

# Secrets and local config: never copied into an image
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key

# Dependencies and build output (rebuilt inside the image)
**/node_modules
**/dist
**/.next
**/.turbo
**/out
**/coverage
**/.cache
**/*.tsbuildinfo
apps/web/public/arena-preview

# Tooling and editor files
.git
.github
.claude
.vscode
.idea
**/.DS_Store
**/npm-debug.log*

# Not needed to build or run the services
docs
load
deploy
judge-images
